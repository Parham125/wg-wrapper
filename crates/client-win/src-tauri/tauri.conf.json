{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wg-wrapper",
  "version": "0.1.6",
  "identifier": "com.github.parham125.wgwrapper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "wg-wrapper",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "maximizable": false,
        "center": true,
        "backgroundColor": "#ECEFED"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxRTA3MDRCQTU3NzUyOEEKUldTS1VuZWxTM0RnOGI3QTc5VjVoV1RLZXdodTBQdXlxWGNJajBibmFkUXN0SGxRcVRJVHo0QjUK",
      "endpoints": ["https://github.com/Parham125/wg-wrapper/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "WireGuard client that tunnels over WSS",
    "longDescription": "Connects to a wg-wrapper relay over WebSocket TLS and routes all traffic through it."
  }
}
