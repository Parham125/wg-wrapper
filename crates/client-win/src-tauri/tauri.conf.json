{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wg-wrapper",
  "version": "0.1.2",
  "identifier": "com.github.parham125.wgwrapper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "wg-wrapper",
        "width": 420,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "backgroundColor": "#0F1A1E"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "WireGuard client that tunnels over WSS",
    "longDescription": "Connects to a wg-wrapper relay over WebSocket TLS and routes all traffic through it."
  }
}
